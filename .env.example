# Copy to .env. Never commit real credentials.
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Use MODEL_PROVIDER=openrouter to route calls through OpenRouter.
# Gemini model names below are automatically prefixed with google/ for OpenRouter.
# Models used by the homogeneous five-agent pipeline.
GENERATOR_MODEL=gemini-2.5-flash
DECOMPOSER_MODEL=gemini-2.5-flash
WEAK_JUDGE_MODEL=gemini-2.5-flash
STRONG_JUDGE_MODEL=gemini-3-flash-preview
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Pinned MiniLM revision. Leave blank to resolve and record the current commit.
EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

GENERATION_TEMPERATURE=0.7
MAX_FACTS_PER_RESPONSE=20
# Larger than the original generation cap to accommodate current models' thinking tokens.
MAX_OUTPUT_TOKENS=8192
# Optional per-stage overrides, as configured in the original experiment pipeline.
# Uncomment to use those historical budgets; current thinking models may truncate.
# GENERATOR_MAX_OUTPUT_TOKENS=2048
# DECOMPOSER_MAX_OUTPUT_TOKENS=8192
# WEAK_JUDGE_MAX_OUTPUT_TOKENS=1024
# STRONG_JUDGE_MAX_OUTPUT_TOKENS=2048
MIN_REQUEST_INTERVAL_SECONDS=13
REQUEST_TIMEOUT_SECONDS=120

# Cumulative estimated spend ceiling per output directory, including resumed runs.
# Defaults use conservative prices for the Flash models above, including thinking tokens.
# Review provider pricing if changing models. A full 300-query regeneration needs a larger budget.
MAX_COST_USD=3
INPUT_USD_PER_MILLION=1
OUTPUT_USD_PER_MILLION=5
